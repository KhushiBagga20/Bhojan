# Copy to .env.local and fill in from Supabase → Project Settings → API.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_...) or the legacy anon key. Safe to ship in the app;
# Row Level Security protects the data. Never put the service role key here.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# How people sign in: "password" (email + password; works without an SMS provider)
# or "otp" (6-digit code by SMS; needs an SMS provider in Supabase Auth).
EXPO_PUBLIC_AUTH_METHOD=password
