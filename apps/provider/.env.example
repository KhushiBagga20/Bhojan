# Copy to .env.local and fill in from Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable (or legacy anon) key. Never put the service role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# How kitchens sign in: "password" (email + password; no SMS provider needed)
# or "otp" (one-time code by SMS or email).
NEXT_PUBLIC_AUTH_METHOD=password
